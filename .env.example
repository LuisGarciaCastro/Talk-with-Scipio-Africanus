# Tu API key de Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=pega_aqui_tu_key
# Modelo Live (compruébalo en AI Studio > rate limits si tienes cuota gratis)
GEMINI_LIVE_MODEL=gemini-3.8-live
# Opcional en local; IMPRESCINDIBLE en Vercel. Si la pones, el enlace debe llevar ?clave=<esto>
ACCESS_CODE=
# Opcional: voz fija de Escipión (Charon por defecto; otras graves: Algenib, Gacrux, Orus)
GEMINI_VOICE=Charon
