# Tu API key de Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=pega_aqui_tu_key
# Modelo Live (compruébalo en AI Studio > rate limits si tienes cuota gratis)
GEMINI_LIVE_MODEL=gemini-3.8-live
# Opcional en local; IMPRESCINDIBLE en Vercel. Si la pones, la app la pide al entrar
ACCESS_CODE=
# Opcional: voz fija de Escipión (Algenib por defecto; otras masculinas: Sadaltager, Charon, Orus)
GEMINI_VOICE=Algenib
